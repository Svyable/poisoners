{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Svyable/poisoners/blob/main/schema/case-dossier.schema.json",
  "title": "POISONERS / Public Case-Intelligence Dossier",
  "description": "Public-only research and expert-review state machine. Never put claimant personal or medical records here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "title",
    "jurisdiction",
    "route",
    "stage",
    "evidence_record_ids",
    "publication_review",
    "counsel_review",
    "updated_at"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^case-[a-z0-9-]{5,72}$"
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "venue_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "route": {
      "enum": [
        "class_action",
        "group_action",
        "public_interest_litigation",
        "representative_action",
        "mass_tort",
        "citizen_suit",
        "administrative_remedy",
        "regulatory_referral",
        "other",
        "unknown"
      ]
    },
    "stage": {
      "enum": [
        "lead",
        "corroborated",
        "scientific_review",
        "jurisdiction_review",
        "counsel_approved",
        "action_authorized",
        "filed",
        "closed"
      ]
    },
    "entity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "facility_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_record_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "potential_receptors": {
      "type": "array",
      "items": {
        "enum": [
          "air",
          "water",
          "soil",
          "plants",
          "animals",
          "humans"
        ]
      }
    },
    "incident_period": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "contested_facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scientific_review": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_started",
            "in_progress",
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "publication_review": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "rebuttal_invitation_sent": {
          "type": "boolean"
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "counsel_review": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_started",
            "in_progress",
            "approved",
            "declined"
          ]
        },
        "qualified_local_counsel": {
          "type": "boolean"
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "class_screen": {
      "type": "object",
      "properties": {
        "standing_reviewed": {
          "type": "boolean"
        },
        "commonality_reviewed": {
          "type": "boolean"
        },
        "causation_reviewed": {
          "type": "boolean"
        },
        "limitations_reviewed": {
          "type": "boolean"
        },
        "remedy_reviewed": {
          "type": "boolean"
        },
        "jurisdiction_reviewed": {
          "type": "boolean"
        },
        "conflicts_reviewed": {
          "type": "boolean"
        }
      }
    },
    "authorization": {
      "type": "object",
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "approver_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "public_summary": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "counsel_approved",
              "action_authorized",
              "filed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "counsel_review": {
            "properties": {
              "status": {
                "const": "approved"
              },
              "qualified_local_counsel": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "action_authorized",
              "filed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "authorization"
        ],
        "properties": {
          "authorization": {
            "required": [
              "approved",
              "approver_role",
              "approved_at"
            ],
            "properties": {
              "approved": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
