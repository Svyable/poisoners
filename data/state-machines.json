{
  "schema_version": 1,
  "audited_on": "2026-11-08",
  "project": "Svyable/poisoners",
  "scope": "Behavioral state transitions in public static UI, source data, research CLI and scheduled CI automation; page navigation is not itself a standalone state machine.",
  "lifecycle_policy": "Observed machines describe current imperative handlers, not generic-reducer adoption. The search-index loader is explicitly implemented by its native guarded transition table; Rank Lab snapshot loading, Workbench catalog loading and Workbench concern/region navigation use the separate pure shared transitions in docs/site.js. Native dialog visibility stays browser-owned; data and scheduled workflows are evidence gates. The UI owner audit also records the previously omitted AEP operator browser and EPA exposure benchmark loader/filter states as observed, not explicit.",
  "cross_cutting_guards": [
    "Never infer zero from missing environmental measurements, corporate payment receipts, or officer identity.",
    "Never turn a source hyperlink into causal verification, legal guilt or person-level exposure.",
    "Never mix different currencies, source years, reporting boundaries or units in a numeric leaderboard.",
    "Never silently attribute a group payment to a single defendant or add a settlement payment to a downstream recipient receipt.",
    "Never transmit workbench notes or personal research to navigation URLs or search-index fetches.",
    "Always keep generated public snapshots reproducible and CI-gated."
  ],
  "machines": [
    {
      "id": "global-search-dialog",
      "owner": "docs/site-search.js",
      "group": "ui",
      "mode": "observed",
      "initial": "closed",
      "states": [
        "closed",
        "open"
      ],
      "persistence": "memory",
      "transitions": [
        {
          "from": "closed",
          "event": "OPEN",
          "to": "open"
        },
        {
          "from": "open",
          "event": "CLOSE",
          "to": "closed"
        }
      ],
      "agent_guard": "Focus restores to opener on close; the user query stays in the browser."
    },
    {
      "id": "global-search-index",
      "owner": "docs/site-search.js",
      "group": "ui",
      "mode": "explicit",
      "initial": "idle",
      "states": [
        "idle",
        "loading",
        "ready",
        "error"
      ],
      "persistence": "memory",
      "transitions": [
        {
          "from": "idle",
          "event": "load",
          "to": "loading"
        },
        {
          "from": "loading",
          "event": "resolve",
          "to": "ready"
        },
        {
          "from": "loading",
          "event": "reject",
          "to": "error"
        },
        {
          "from": "error",
          "event": "retry",
          "to": "loading"
        }
      ],
      "agent_guard": "Global search index loader has an explicit four-phase transition table and a shared pending promise. Open modal sessions reuse the same fetch, errors can retry, and close/cycle guards prevent late responses from painting a closed or newer dialog."
    },
